{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomazb/cursor-multi-agent-software-engineer/schemas/config.schema.json",
  "title": "MasweConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runtime", "roles", "gates", "quality", "policy"],
  "properties": {
    "version": { "const": 1 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "outputFormat"],
      "properties": {
        "kind": { "enum": ["mock", "cursor-cli", "cursor-sdk"] },
        "command": { "type": "string", "minLength": 1 },
        "outputFormat": { "enum": ["json", "text", "stream-json"] }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brainstormer", "designer", "builder", "verifier", "prResolver"],
      "properties": {
        "brainstormer": { "$ref": "#/$defs/brainstormerRole" },
        "designer": { "$ref": "#/$defs/designerRole" },
        "builder": { "$ref": "#/$defs/builderRole" },
        "verifier": { "$ref": "#/$defs/verifierRole" },
        "prResolver": { "$ref": "#/$defs/prResolverRole" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireBrainstormApproval",
        "requireDesignApproval",
        "requireCiPass",
        "requireVerifierPass"
      ],
      "properties": {
        "requireBrainstormApproval": { "type": "boolean" },
        "requireDesignApproval": { "type": "boolean" },
        "requireCiPass": { "type": "boolean" },
        "requireVerifierPass": { "type": "boolean" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rejectModelFallback",
        "maxBuildVerifyCycles",
        "maxCommentResolutionCycles",
        "allowDirtyWorkspace",
        "useIsolatedWorktree",
        "trustManagedWorktrees",
        "promptTransport",
        "commandTimeoutMs",
        "roleTimeoutMs",
        "doctorProbeTimeoutMs",
        "allowedPathGlobs"
      ],
      "properties": {
        "rejectModelFallback": { "type": "boolean" },
        "maxBuildVerifyCycles": { "type": "integer", "minimum": 1 },
        "maxCommentResolutionCycles": { "type": "integer", "minimum": 1 },
        "allowDirtyWorkspace": { "type": "boolean" },
        "useIsolatedWorktree": { "type": "boolean" },
        "trustManagedWorktrees": { "type": "boolean" },
        "promptTransport": { "enum": ["stdin", "argv"] },
        "commandTimeoutMs": { "type": "integer", "minimum": 1 },
        "roleTimeoutMs": { "type": "integer", "minimum": 1 },
        "doctorProbeTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "maxRunDurationMs": { "type": "integer", "minimum": 1 },
        "allowedPathGlobs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "githubApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "readOnlyChecks",
        "webhookSecretEnv",
        "appIdEnv",
        "privateKeyEnv",
        "allowedRepositoryIds",
        "allowedRepositories"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "readOnlyChecks": { "type": "boolean" },
        "webhookSecretEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "appIdEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "privateKeyEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "allowedRepositoryIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "allowedRepositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/\\s]+/[^/\\s]+$"
          }
        },
        "webhookHost": { "type": "string", "minLength": 1 },
        "webhookPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["enabled"],
            "properties": {
              "enabled": { "const": true }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "readOnlyChecks": { "const": true }
            },
            "anyOf": [
              {
                "type": "object",
                "required": ["allowedRepositoryIds"],
                "properties": {
                  "allowedRepositoryIds": { "type": "array", "minItems": 1 }
                }
              },
              {
                "type": "object",
                "required": ["allowedRepositories"],
                "properties": {
                  "allowedRepositories": { "type": "array", "minItems": 1 }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning", "permissions"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "fallbackModels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reasoning": { "enum": ["low", "medium", "high"] },
        "permissions": { "enum": ["read-only", "workspace-write"] }
      }
    },
    "brainstormerRole": {
      "allOf": [
        { "$ref": "#/$defs/role" },
        { "type": "object", "properties": { "permissions": { "const": "read-only" } } }
      ]
    },
    "designerRole": {
      "allOf": [
        { "$ref": "#/$defs/role" },
        { "type": "object", "properties": { "permissions": { "const": "read-only" } } }
      ]
    },
    "builderRole": {
      "allOf": [
        { "$ref": "#/$defs/role" },
        { "type": "object", "properties": { "permissions": { "const": "workspace-write" } } }
      ]
    },
    "verifierRole": {
      "allOf": [
        { "$ref": "#/$defs/role" },
        { "type": "object", "properties": { "permissions": { "const": "read-only" } } }
      ]
    },
    "prResolverRole": {
      "allOf": [
        { "$ref": "#/$defs/role" },
        { "type": "object", "properties": { "permissions": { "const": "workspace-write" } } }
      ]
    }
  }
}
